<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {% # Google Fonts %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">

    <script>
      window.ShopifyLocale = "{{ request.locale.iso_code }}";
      window.ShopifyCurrency = "{{ cart.currency.iso_code }}";
    </script>

    {% # Load style.css from assets %}
    {{ 'style.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="page-{% if template.name == 'index' or template == 'index' or request.page_type == 'index' %}home{% else %}{{ template.name }}{% endif %}">
    {% sections 'header-group' %}

    <main id="main-content" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% # Theme scripts %}
    <script src="{{ 'i18n.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
    <script src="https://unpkg.com/lenis@1.1.14/dist/lenis.min.js"></script>
    <script src="{{ 'main.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
