<section class="section">
  <div class="container">
    <div class="section-header animate-on-scroll">
      <span class="section-header__label" data-i18n="cat_heading">{{ section.settings.label }}</span>
      <h2 class="section-header__title" data-i18n="cat_title">{{ section.settings.title }}</h2>
    </div>

    <div class="category-grid">
      {% for block in section.blocks %}
        {% assign anim_delay = forloop.index %}
        {% assign cat_title_dc = block.settings.title | downcase %}
        {% assign cat_i18n_title = "" %}
        {% assign cat_i18n_desc = "" %}
        {% if cat_title_dc contains 'tělo' or cat_title_dc contains 'telo' or cat_title_dc contains 'body' or cat_title_dc contains 'domácí' or cat_title_dc contains 'domaci' %}
          {% assign cat_i18n_title = "cat_body_care" %}
          {% assign cat_i18n_desc = "cat_body_care_desc" %}
        {% elsif cat_title_dc contains 'profesionál' or cat_title_dc contains 'profesional' or cat_title_dc contains 'professional' %}
          {% assign cat_i18n_title = "cat_professional" %}
          {% assign cat_i18n_desc = "cat_professional_desc" %}
        {% elsif cat_title_dc contains 'zeštíhlení' or cat_title_dc contains 'zestihleni' or cat_title_dc contains 'slimming' %}
          {% assign cat_i18n_title = "cat_slimming" %}
          {% assign cat_i18n_desc = "cat_slimming_desc" %}
        {% endif %}
        
        {% assign cat_btn_label_dc = block.settings.btn_label | downcase %}
        {% assign cat_i18n_btn = "" %}
        {% if cat_btn_label_dc contains 'zobrazit' or cat_btn_label_dc contains 'show' or cat_btn_label_dc contains 'view' %}
          {% assign cat_i18n_btn = "btn_show" %}
        {% elsif cat_btn_label_dc contains 'rezervovat' or cat_btn_label_dc contains 'book' %}
          {% assign cat_i18n_btn = "btn_book" %}
        {% endif %}
        <a href="{{ block.settings.url }}" class="category-card animate-on-scroll animate-delay-{{ anim_delay }}" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img class="category-card__image" src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
          {% else %}
            {% capture fallback_svg %}
              data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='400' height='500'><rect width='400' height='500' fill='%23EDE8E2'/></svg>
            {% endcapture %}
            <img class="category-card__image" src="{{ fallback_svg | strip }}" alt="{{ block.settings.title | escape }}" loading="lazy">
          {% endif %}
          <div class="category-card__overlay"></div>
          <div class="category-card__content">
            <span class="category-card__name" {% if cat_i18n_title != "" %}data-i18n="{{ cat_i18n_title }}"{% endif %}>{{ block.settings.title }}</span>
            <p class="category-card__desc" {% if cat_i18n_desc != "" %}data-i18n="{{ cat_i18n_desc }}"{% endif %}>{{ block.settings.desc }}</p>
            <span class="category-card__arrow">
              <span {% if cat_i18n_btn != "" %}data-i18n="{{ cat_i18n_btn }}"{% endif %}>{{ block.settings.btn_label }}</span> →
            </span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kategorie BYELMARIE",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Označení sekce",
      "default": "Naše kategorie"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Nadpis sekce",
      "default": "Péče o tělo & Profesionální řešení"
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Karta kategorie",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Obrázek karty"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Název kategorie",
          "default": "Produkty pro domácí i profesionální použití"
        },
        {
          "type": "text",
          "id": "desc",
          "label": "Popisek",
          "default": "Baňky, válečky a séra pro péči o tělo"
        },
        {
          "type": "text",
          "id": "btn_label",
          "label": "Text tlačítka",
          "default": "Zobrazit"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Odkaz"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kategorie BYELMARIE",
      "blocks": [
        {
          "type": "category_card",
          "settings": {
            "title": "Produkty pro domácí i profesionální použití",
            "desc": "Baňky, válečky a séra pro péči o tělo"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Produkty pro Vaše podnikání",
            "desc": "Školení, pomůcky a přístroje pro salony"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Salon BYELMARIE® Brno",
            "desc": "Navštivte nás osobně v Brně, Královo Pole"
          }
        }
      ]
    }
  ]
}
{% endschema %}
