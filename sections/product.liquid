                        <span>Rychlá návratnost</span>
                      </div>
                      <p class="ems-card__text">Vysoká ziskovost při ceně ošetření od 1 000 Kč za 25 minut.</p>
                    </div>

                    <div class="ems-card">
                      <div class="ems-card__title">
                        <span class="ems-card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                        <span>Kompletní balíček</span>
                      </div>
                      <p class="ems-card__text">Dodací lhůta 30 dní. Zaškolení, certifikát a marketingové materiály jsou součástí balení.</p>
                    </div>
                  </div>

                  <div class="ems-warning-box">
                    <p><strong>⚠️ Kontraindikace:</strong> Kardiostimulátor, těhotenství, epilepsie, závažná akutní onemocnění.</p>
                  </div>
                </div>
              {%- else -%}
                {{ product.description }}
              {%- endif -%}
            </div>
        </div>

        <div class="accordion-item">
          <button class="accordion-trigger" onclick="toggleAccordion(this)">
            <span data-i18n="prod_shipping">Doprava a vrácení</span>
            <span class="accordion-icon"></span>
          </button>
          <div class="accordion-content">
            <div class="accordion-body">
              <p data-i18n="prod_shipping_text">{{ section.settings.shipping_text }}</p>
              <div style="margin-top: var(--space-4); border-top: 1px solid var(--color-border); padding-top: var(--space-4);">
                <a href="/pages/doprava-a-platba" style="color: var(--color-accent-dark); font-weight: 500; text-decoration: underline;" data-i18n="prod_shipping_link">Podrobné informace o dopravě a platbě naleznete zde →</a>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Související produkty -->
  {%- assign related_collection = product.collections.first -%}
  {%- if related_collection != blank and related_collection.products_count > 1 -%}
    <section class="section section--sm" style="border-top: 1px solid var(--color-border); margin-top: var(--space-12);">
      <div class="section-header">
        <span class="section-header__label" data-i18n="prod_related_label">Mohlo by vás zajímat</span>
        <h2 class="section-header__title" style="font-size: 2rem;" data-i18n="prod_related_title">Další produkty</h2>
      </div>
      <div class="product-grid" id="related-products">
        {%- assign current_id = product.id -%}
        {%- assign counter = 0 -%}
        {%- for related_prod in related_collection.products -%}
          {%- if related_prod.id != current_id and counter < 4 -%}
            {%- render 'product-card', product: related_prod -%}
            {%- assign counter = counter | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

</div>

<script>
  let currentImageIndex = 0;
  const productImages = [
    {% for image in product.images %}
      "{{ image | image_url: width: 800 }}"{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  window.selectImage = function (src, thumbEl) {
    const mainImg = document.getElementById('main-product-image');
    if (mainImg) mainImg.src = src;
    
    document.querySelectorAll('.product-gallery__thumb').forEach(t => t.classList.remove('active'));
    if (thumbEl) {
      thumbEl.classList.add('active');
      const thumbs = Array.from(document.querySelectorAll('.product-gallery__thumb'));
      currentImageIndex = thumbs.indexOf(thumbEl);
    }
  };

  window.navigateGallery = function (direction) {
    if (productImages.length <= 1) return;
    currentImageIndex = (currentImageIndex + direction + productImages.length) % productImages.length;
    const nextImg = productImages[currentImageIndex];
    const thumbs = document.querySelectorAll('.product-gallery__thumb');
    if (thumbs && thumbs[currentImageIndex]) {
      selectImage(nextImg, thumbs[currentImageIndex]);
    } else {
      const mainImg = document.getElementById('main-product-image');
      if (mainImg) mainImg.src = nextImg;
    }
  };

  window.toggleAccordion = function (trigger) {
    const item = trigger.closest('.accordion-item');
    const isOpen = item.classList.contains('open');

    document.querySelectorAll('.accordion-item.open').forEach(i => i.classList.remove('open'));
    if (!isOpen) item.classList.add('open');
  };

  // Variant selection handler
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.variant-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        if (btn.classList.contains('disabled')) return;
        
        document.querySelectorAll('.variant-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        
        const variantId = btn.getAttribute('data-variant-id');
        const price = btn.getAttribute('data-variant-price');
        
        // Update hidden input
        const input = document.getElementById('selected-variant-id');
        if (input) input.value = variantId;
        
        // Update price display
        const priceEl = document.getElementById('detail-price');
        if (priceEl) {
          priceEl.setAttribute('data-price', price);
          if (typeof formatPrice === 'function') {
            priceEl.textContent = formatPrice(parseInt(price));
          } else {
            priceEl.textContent = price + ' Kč';
          }
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Detail produktu BYELMARIE",
  "settings": [
    {
      "type": "textarea",
      "id": "shipping_text",
      "label": "Text o dopravě",
      "default": "Doprava zdarma od 2 500 Kč. Vrácení do 14 dní."
    }
  ]
}
{% endschema %}
