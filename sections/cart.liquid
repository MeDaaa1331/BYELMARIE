<div class="page-hero" style="padding: var(--space-16) 0 var(--space-10);">
  <div class="container">
    <div class="breadcrumb">
      <a href="{{ routes.root_url }}" data-i18n="nav_home">Domů</a>
      <span class="breadcrumb__sep">/</span>
      <span data-i18n="cart_title">Váš košík</span>
    </div>
    <h1 class="page-hero__title" data-i18n="cart_title">Váš košík</h1>
  </div>
</div>

<div class="container">

  {%- if cart.item_count == 0 -%}
    <div id="cart-empty">
      <div class="cart-empty-state">
        <div class="cart-empty-state__icon">
          <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M8 8h6l8 32h26l8-20H16" />
            <circle cx="26" cy="52" r="3" />
            <circle cx="44" cy="52" r="3" />
          </svg>
        </div>
        <h2 class="cart-empty-state__title" data-i18n="cart_empty">Váš košík je prázdný</h2>
        <p class="cart-empty-state__text" data-i18n="cart_empty_text">Přidejte produkty z našeho e-shopu</p>
        <a href="/collections/all" class="btn btn-primary" data-i18n="cart_continue">Pokračovat v nákupu</a>
      </div>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" id="cart-form">
      <div id="cart-filled">
        <div class="cart-layout">

          <div>
            <div style="display:grid; grid-template-columns:96px 1fr auto auto auto; gap:var(--space-5); padding:var(--space-3) 0; border-bottom:1px solid var(--color-border); font-size:var(--font-size-xs); letter-spacing:0.12em; text-transform:uppercase; color:var(--color-text-muted);">
              <span></span>
              <span>Produkt</span>
              <span>Množství</span>
              <span style="text-align:right;">Cena</span>
              <span></span>
            </div>

            <div id="cart-items">
              {%- for item in cart.items -%}
                <div class="cart-item" data-key="{{ item.key }}">
                  <div class="cart-item__image">
                    {%- if item.image != blank -%}
                      <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.product.title | escape }}" loading="lazy">
                    {%- else -%}
                      <img src="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100'><rect width='100' height='100' fill='%23f0ede8'/></svg>" alt="">
                    {%- endif -%}
                  </div>
                  <div class="cart-item__info">
                    <a href="{{ item.url }}" class="cart-item__name">{{ item.product.title }}</a>
                    {%- unless item.product.has_only_default_variant -%}
                      <div class="cart-item__variant">({{ item.variant.title }})</div>
                    {%- endunless -%}
                    <div class="cart-item__price-unit">{{ item.final_price | money_without_trailing_zeros }}</div>
                  </div>
                  <div class="cart-item__qty">
                    <a class="qty-btn" href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity={{ item.quantity | minus: 1 }}">−</a >
                    <span class="qty-value">{{ item.quantity }}</span>
                    <a class="qty-btn" href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity={{ item.quantity | plus: 1 }}">+</a>
                  </div>
                  <div class="cart-item__total">{{ item.final_line_price | money_without_trailing_zeros }}</div>
                  <a href="{{ item.url_to_remove }}" class="cart-item__remove" aria-label="Odstranit">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <line x1="1" y1="1" x2="15" y2="15" stroke="currentColor" stroke-width="1.5"/>
                      <line x1="15" y1="1" x2="1" y2="15" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                  </a>
                </div>
              {%- endfor -%}
            </div>
          </div>

          <div class="cart-summary-box">
            <h3 style="font-size:var(--font-size-lg); margin-bottom:var(--space-5); letter-spacing:-0.01em;" data-i18n="cart_total">Celkem</h3>

            <div class="cart-summary-row">
              <span style="color:var(--color-text-muted); font-size:var(--font-size-sm);">Mezisoučet</span>
              <span id="cart-subtotal">{{ cart.items_subtotal_price | money_without_trailing_zeros }}</span>
            </div>
            <div class="cart-summary-row">
              <span style="color:var(--color-text-muted); font-size:var(--font-size-sm);">Doprava</span>
              <span id="cart-shipping">Vypočítá se při objednávce</span>
            </div>
            <div class="cart-summary-row total">
              <span data-i18n="cart_total">Celkem</span>
              <span id="cart-total-price">{{ cart.total_price | money_without_trailing_zeros }}</span>
            </div>

            <button type="submit" name="checkout" class="btn btn-primary" style="width:100%;margin-top:var(--space-6);padding:var(--space-5);justify-content:center;">
              <span data-i18n="cart_checkout">Přejít k pokladně</span>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M3 8h10M9 4l4 4-4 4" />
              </svg>
            </button>

            <p style="font-size:var(--font-size-xs); color:var(--color-text-muted); text-align:center; margin-top:var(--space-4);">
              Bezpečné platby · Doprava do 3 dnů
            </p>

            <div style="margin-top: var(--space-6); text-align: center;">
              <a href="/collections/all" style="font-size:var(--font-size-xs); letter-spacing:0.1em; text-transform:uppercase; color:var(--color-text-muted); text-decoration:underline;" data-i18n="cart_continue">Pokračovat v nákupu</a>
            </div>
          </div>

        </div>

        <!-- Doporučení produktů v košíku -->
        {%- assign recommend_collection = collections['body-care'] | default: collections.first -%}
        {%- if recommend_collection != blank and recommend_collection.products_count > 0 -%}
          <section class="section section--sm" style="border-top: 1px solid var(--color-border); margin-top: var(--space-16);">
            <div class="section-header">
              <span class="section-header__label" data-i18n="cart_recommend_label">Doporučujeme</span>
              <h2 class="section-header__title" style="font-size: 2rem;" data-i18n="cart_recommend_title">Mohlo by vás zajímat</h2>
            </div>
            <div class="product-grid" id="recommended-products">
              {%- assign count = 0 -%}
              {%- for prod in recommend_collection.products -%}
                {%- if count < 4 -%}
                  {%- render 'product-card', product: prod -%}
                  {%- assign count = count | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </section>
        {%- endif -%}
      </div>
    </form>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Košík BYELMARIE",
  "settings": []
}
{% endschema %}
