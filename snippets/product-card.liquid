{% comment %}
  Renders a product card
  Accepts:
  - product: {Object} Product object
{% endcomment %}

{%- assign is_sold_out = true -%}
{%- if product.available -%}
  {%- assign is_sold_out = false -%}
{%- endif -%}

{%- assign is_on_request = false -%}
{%- if product.tags contains 'on-request' or product.tags contains 'Na dotaz' or product.price == 0 -%}
  {%- assign is_on_request = true -%}
{%- endif -%}

<article class="product-card {% if is_sold_out %}product-card--sold-out{% endif %}" data-product-id="{{ product.id }}">
  <a href="{{ product.url }}" class="product-card__image-link">
    <div class="product-card__image-wrap">
      {%- if product.featured_image != blank -%}
        <img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title | escape }}" class="product-card__image" loading="lazy">
      {%- else -%}
        <img src="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='400' height='400'><rect width='400' height='400' fill='%23f0ede8'/><text x='50%25' y='50%25' text-anchor='middle' fill='%23cdc1b3' font-size='18' dy='.3em'>BYELMARIE</text></svg>" alt="{{ product.title | escape }}" class="product-card__image">
      {%- endif -%}

      {%- if is_sold_out -%}
        <span class="product-card__badge product-card__badge--sold-out" data-i18n="sold_out">Vyprodáno</span>
      {%- elsif is_on_request -%}
        <span class="product-card__badge product-card__badge--request" data-i18n="on_request">Na dotaz</span>
      {%- else -%}
        {%- for tag in product.tags -%}
          {%- if tag contains 'badge:' -%}
            {%- assign badge_text = tag | remove: 'badge:' -%}
            <span class="product-card__badge">{{ badge_text }}</span>
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </a>

  <div class="product-card__info">
    <a href="{{ product.url }}" class="product-card__name">{{ product.title }}</a>
    <div class="product-card__price-row">
      {%- if is_sold_out -%}
        <span class="price sold-out" data-i18n="sold_out">Vyprodáno</span>
      {%- elsif is_on_request -%}
        <span class="price on-request" data-i18n="on_request">Na dotaz</span>
      {%- else -%}
        {%- if product.price_varies -%}
          <span class="price" data-price-from="{{ product.price_min | divided_by: 100 }}"><span data-i18n="from">od</span> {{ product.price_min | money_without_trailing_zeros }}</span>
        {%- else -%}
          <span class="price" data-price="{{ product.price | divided_by: 100 }}">{{ product.price | money_without_trailing_zeros }}</span>
        {%- endif -%}
      {%- endif -%}

      {%- if is_sold_out -%}
        <span class="btn-add-to-cart btn-disabled" data-i18n="sold_out">Vyprodáno</span>
      {%- elsif is_on_request -%}
        <a href="{{ pages.contact.url | default: '/pages/contact' }}" class="btn-add-to-cart btn-outline" data-i18n="on_request">Na dotaz</a>
      {%- else -%}
        {%- if product.has_only_default_variant -%}
          <form method="post" action="/cart/add" class="quick-add-form" data-type="ajax-add-to-cart">
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" />
            <button type="submit" class="btn-add-to-cart" data-i18n="add_to_cart">Do košíku</button>
          </form>
        {%- else -%}
          <a href="{{ product.url }}" class="btn-add-to-cart" data-i18n="choose_variant">Koupit</a>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</article>
